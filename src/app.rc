#include <windows.h>
// Embed DPI awareness and current-user privilege requirements.
1 RT_MANIFEST "app.manifest"
// Ship the read-only collector inside the binary, not as a loose runtime file.
101 RCDATA "../collectors/linux.sh"
// Expose the product identity in Explorer without an installer.
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Node-Sight - native desktop monitor\0"
   VALUE "ProductName", "Node-Sight\0"
   VALUE "FileVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
